{
  "name": "venta-pos",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "server",
    "mobile"
  ],
  "scripts": {
    "server": "npm run dev -w server",
    "mobile": "npm run start -w mobile",
    "test": "npm test -w server",
    "check": "npm run check -w mobile",
    "setup-admin": "npm run setup-admin -w server",
    "backup": "npm run backup -w server",
    "test:e2e": "node scripts/business-e2e.mjs",
    "dev": "node scripts/dev.mjs",
    "build:android": "node scripts/build-android.mjs",
    "test:offline": "node --test server/test/offline.test.js",
    "doctor": "npx expo-doctor mobile"
  },
  "engines": {
    "node": "^24.3.0 || >=26.0.0"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/react": "~19.3.0"
  }
}
