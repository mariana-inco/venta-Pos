{
  "expo": {
    "name": "DOK POLLO MC",
    "slug": "venta-pos",
    "version": "1.4.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "ventapos",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ventapos.mobile",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Conectar con el servidor de tu negocio en la red local."
      }
    },
    "android": {
      "package": "com.ventapos.mobile",
      "allowBackup": false,
      "versionCode": 18
    },
    "plugins": [
      "expo-secure-store",
      "expo-sqlite",
      "expo-background-task",
      "./plugins/with-local-network.cjs",
      "./plugins/with-release-keep-rules.cjs",
      [
        "expo-image-picker",
        {
          "photosPermission": "Selecciona comprobantes para evidencias de gastos.",
          "cameraPermission": "Toma fotografías de comprobantes de gastos.",
          "microphonePermission": false
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "favicon": "./assets/brand/dok-pollo-mc.png",
      "name": "DOK POLLO MC",
      "themeColor": "#202124"
    },
    "platforms": [
      "android",
      "web"
    ],
    "icon": "./assets/brand/dok-pollo-mc.png"
  }
}
