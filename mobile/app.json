{
  "expo": {
    "name": "Dok Pollo MC",
    "slug": "venta-pos",
    "version": "1.1.2",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "ventapos",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ventapos.mobile",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Conectar con el servidor de tu negocio en la red local."
      }
    },
    "android": {
      "package": "com.ventapos.mobile",
      "allowBackup": false,
      "versionCode": 4
    },
    "plugins": [
      "expo-secure-store",
      "expo-sqlite",
      "expo-background-task",
      "./plugins/with-local-network.cjs"
    ],
    "web": {
      "bundler": "metro",
      "favicon": "./assets/brand/dok-pollo-mc.png",
      "name": "Dok Pollo MC",
      "themeColor": "#1E7A3C"
    },
    "platforms": [
      "android",
      "web"
    ],
    "icon": "./assets/brand/dok-pollo-mc.png"
  }
}
